---
interface Props {
  images: string[]
  class?: string
}

const { images, class: className = '' } = Astro.props
const chunkSize = Math.ceil(images.length / 4)
const chunks = Array.from({ length: 4 }, (_, colIndex) => {
  const start = colIndex * chunkSize
  return images.slice(start, start + chunkSize)
})
---

<div class={`relative mx-auto block h-[460px] w-full overflow-hidden rounded-2xl border bg-muted/60 dark:bg-muted/30 sm:h-[560px] lg:h-[600px] ${className}`}>
  <div class="flex size-full items-center justify-center">
    <div class="size-[1720px] shrink-0 scale-[0.54] sm:scale-[0.76] lg:scale-[0.92]">
      <div
        style="transform: rotateX(55deg) rotateY(0deg) rotateZ(-45deg); transform-style: preserve-3d;"
        class="relative top-96 right-[46%] grid size-full origin-top-left grid-cols-4 gap-8"
      >
        {
          chunks.map((subarray, colIndex) => (
            <div class={`relative flex flex-col items-start gap-8 ${colIndex % 2 === 0 ? 'cloak-marquee-col-even' : 'cloak-marquee-col-odd'}`}>
              <div
                aria-hidden="true"
                class="pointer-events-none absolute -left-4 z-30 -top-10 h-[calc(100%+80px)] w-px bg-[linear-gradient(to_bottom,rgba(0,0,0,0.16),rgba(0,0,0,0.16)_50%,transparent_0,transparent)] dark:bg-[linear-gradient(to_bottom,rgba(255,255,255,0.16),rgba(255,255,255,0.16)_50%,transparent_0,transparent)] bg-[length:1px_5px]"
                style="mask: linear-gradient(to top, #fff 90%, transparent), linear-gradient(to bottom, #fff 90%, transparent), linear-gradient(#000, #000); mask-composite: exclude;"
              />
              {subarray.map((image, imageIndex) => (
                <div class="relative w-full">
                  <div
                    aria-hidden="true"
                    class="pointer-events-none absolute -top-4 -left-2.5 z-30 h-px w-[calc(100%+20px)] bg-[linear-gradient(to_right,rgba(0,0,0,0.16),rgba(0,0,0,0.16)_50%,transparent_0,transparent)] dark:bg-[linear-gradient(to_right,rgba(255,255,255,0.16),rgba(255,255,255,0.16)_50%,transparent_0,transparent)] bg-[length:5px_1px]"
                    style="mask: linear-gradient(to left, #fff 90%, transparent), linear-gradient(to right, #fff 90%, transparent), linear-gradient(#000, #000); mask-composite: exclude;"
                  />
                  <img
                    src={image}
                    alt={`Cloak screenshot ${colIndex * chunkSize + imageIndex + 1}`}
                    width={970}
                    height={700}
                    class="aspect-[970/700] w-full rounded-lg bg-card object-cover ring-1 ring-black/5 dark:ring-white/10 shadow-sm transition-transform duration-300 ease-out hover:-translate-y-2.5 hover:shadow-xl"
                  />
                </div>
              ))}
            </div>
          ))
        }
      </div>
    </div>
  </div>

  <!-- Soft edge vignette blending into background -->
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 rounded-2xl bg-[radial-gradient(circle_at_center,transparent_50%,rgba(255,255,255,0.45)_100%)] dark:bg-[radial-gradient(circle_at_center,transparent_48%,rgba(10,10,10,0.6)_100%)]"
  />
</div>
