---
interface Props {
  images: string[]
  class?: string
}

const { images, class: className = '' } = Astro.props
const chunkSize = Math.ceil(images.length / 4)
const chunks = Array.from({ length: 4 }, (_, colIndex) => {
  const start = colIndex * chunkSize
  return images.slice(start, start + chunkSize)
})
---

<div class={`relative mx-auto block h-[460px] w-full overflow-hidden rounded-2xl border border-page-border bg-page-surface sm:h-[580px] lg:h-[620px] ${className}`}>
  <div class="flex size-full items-center justify-center">
    <div class="size-[1720px] shrink-0 scale-[0.54] sm:scale-[0.76] lg:scale-[0.92]">
      <div
        style="transform: rotateX(55deg) rotateY(0deg) rotateZ(-45deg); transform-style: preserve-3d;"
        class="relative top-96 right-[46%] grid size-full origin-top-left grid-cols-4 gap-8"
      >
        {
          chunks.map((subarray, colIndex) => (
            <div class={`relative flex flex-col items-start gap-8 ${colIndex % 2 === 0 ? 'cloak-marquee-col-even' : 'cloak-marquee-col-odd'}`}>
              <div
                aria-hidden="true"
                class="pointer-events-none absolute -left-4 z-30 -top-10 h-[calc(100%+80px)] w-px"
                style="background: linear-gradient(to bottom, rgba(255, 255, 255, 0.16), rgba(255, 255, 255, 0.16) 50%, transparent 0, transparent); background-size: 1px 5px; mask: linear-gradient(to top, #fff 90%, transparent), linear-gradient(to bottom, #fff 90%, transparent), linear-gradient(#000, #000); mask-composite: exclude;"
              />
              {subarray.map((image, imageIndex) => (
                <div class="relative w-full">
                  <div
                    aria-hidden="true"
                    class="pointer-events-none absolute -top-4 -left-2.5 z-30 h-px w-[calc(100%+20px)]"
                    style="background: linear-gradient(to right, rgba(255, 255, 255, 0.16), rgba(255, 255, 255, 0.16) 50%, transparent 0, transparent); background-size: 5px 1px; mask: linear-gradient(to left, #fff 90%, transparent), linear-gradient(to right, #fff 90%, transparent), linear-gradient(#000, #000); mask-composite: exclude;"
                  />
                  <img
                    src={image}
                    alt={`Cloak screenshot ${colIndex * chunkSize + imageIndex + 1}`}
                    width={970}
                    height={700}
                    class="aspect-[970/700] w-full rounded-lg bg-[#171a20] object-cover ring-1 ring-white/10 shadow-[0_18px_36px_rgba(0,0,0,0.45)] transition-transform duration-300 ease-out hover:-translate-y-2.5"
                  />
                </div>
              ))}
            </div>
          ))
        }
      </div>
    </div>
  </div>

  <!-- Soft edge vignette blending into obsidian canvas -->
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 rounded-2xl"
    style="background: radial-gradient(circle at center, transparent 42%, rgba(9, 10, 12, 0.72) 100%), linear-gradient(to bottom, rgba(9,10,12,0.55) 0%, transparent 18%, transparent 82%, rgba(9,10,12,0.7) 100%);"
  />
</div>
