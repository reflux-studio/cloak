{
  "name": "cloak-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "scripts": {
    "dev": "pnpm --filter @cloak/desktop dev",
    "tauri": "pnpm --filter @cloak/desktop tauri",
    "build:desktop": "pnpm --filter @cloak/desktop build",
    "dev:site": "pnpm --filter @cloak/site dev",
    "build:site": "pnpm --filter @cloak/site build",
    "typecheck": "pnpm -r typecheck",
    "release": "node scripts/release.js",
    "prerelease": "pnpm --filter @cloak/desktop typecheck && cd apps/desktop/src-tauri && cargo check"
  },
  "devDependencies": {
    "@inquirer/prompts": "^7.5.3",
    "semver": "^7.7.2"
  }
}
